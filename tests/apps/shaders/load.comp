#version 450

layout(local_size_x = 256) in;
layout(std430, set = 0, binding = 0) buffer Out { float data[]; };
layout(push_constant) uniform PC { uint iters; } pc;

// A dependent chain of transcendental math: the run time is proportional to `iters`, and
// the compiler cannot fold it because every iteration needs the previous result.
void main()
{
	float x = float(gl_GlobalInvocationID.x) * 1e-3;
	for (uint i = 0u; i < pc.iters; i++)
		x = sin(x) * 1.5 + cos(x * 1.3) * 0.5 + 0.001;
	data[gl_GlobalInvocationID.x] = x;
}
